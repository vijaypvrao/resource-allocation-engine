# Optional. Unconfigured means deterministic Greedy and Hungarian / Global Optimization.
LLM_ENABLED=false
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=10
# For a remote OpenAI-compatible provider: set LLM_PROVIDER=openai_compatible,
# LLM_BASE_URL=https://your-provider.example/v1, and LLM_API_KEY (never commit secrets).
# LLM_API_KEY=

# Supported: ollama, openai_compatible, openai, groq, openrouter, together,
# lmstudio, vllm, azure_openai (standard OpenAI-compatible /v1 endpoint only).
# Explicit LLM_BASE_URL is required for providers other than Ollama.
